<Window x:Class="BootMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="System Boot Monitor" 
        Height="340" Width="380" 
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False"
        KeyDown="Window_KeyDown" MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Border Background="#1E1E24" CornerRadius="12" BorderBrush="#3A3A42" BorderThickness="1.5">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Status Header -->
            <!-- Close button (window has no title bar or taskbar entry) -->
            <Button Name="BtnClose" Grid.Row="0" Content="✕" ToolTip="Close (Esc)" Click="BtnClose_Click"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Width="24" Height="24" Margin="0,-8,-8,0"
                    Background="Transparent" Foreground="#8A8A93" BorderThickness="0" FontSize="14" Cursor="Hand" Panel.ZIndex="1"/>

            <StackPanel Grid.Row="0" Margin="0,0,24,15">
                <TextBlock Name="TxtStatus" Text="System Loading..." FontSize="20" FontWeight="Bold" Foreground="#FFCC00"/>
                <TextBlock Name="TxtSystemMetrics" Text="CPU: 0% | Disk: 0%" FontSize="12" Foreground="#8A8A93" Margin="0,4,0,0"/>
                <!-- Heaviest processes right now (any process, not just startup entries) -->
                <TextBlock Name="TxtBusy" Text="" FontSize="11" Foreground="#C8A040" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <!-- Visual Progress Indicator -->
            <ProgressBar Name="BootProgress" Grid.Row="1" Height="8" Foreground="#FFCC00" Background="#2D2D37" BorderThickness="0" IsIndeterminate="True" Margin="0,0,0,15"/>

            <!-- List of Detected Startup Processes -->
            <DockPanel Grid.Row="2">
                <TextBlock DockPanel.Dock="Top" Text="Monitored Boot Targets:" FontSize="11" FontWeight="SemiBold" Foreground="#A0A0AA" Margin="0,0,0,5"/>
                <ListBox Name="LstProcesses" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,3">
                                <TextBlock Text="● " Foreground="{Binding StatusColor}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ProcessName}" Foreground="#E1E1E6" FontSize="13" Width="200" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusColor}" FontSize="12" Margin="10,0,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- Run-at-startup toggle (text is set in code: "Remove from startup" / "Add to startup") -->
            <Button Name="BtnStartup" Grid.Row="3" Content="Remove from startup" Click="BtnStartup_Click"
                    HorizontalAlignment="Left" Margin="0,8,0,-6" Padding="0" Cursor="Hand"
                    Background="Transparent" Foreground="#8A8A93" BorderThickness="0" FontSize="11"
                    ToolTip="Toggle whether Boot Monitor runs automatically when you log in"/>
        </Grid>
    </Border>
</Window>